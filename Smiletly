entity:SetCallback("OnSpawned", function()
	print("Smiletly spawned")

	task.spawn(function()
		for _ = 1, 50 do
			local model = entity.Model

			if model and model.Parent then
				task.wait(0.2)
				Create2DEntity(model)
				return
			end

			task.wait(0.1)
		end

		warn("Smiletly: model not found")
	end)
end)

entity:SetCallback("OnStartMoving", function()
	print("Smiletly started moving")
end)

entity:SetCallback("OnEnterRoom", function(room, firstTime)
end)

entity:SetCallback("OnLookAt", function(isInSight)
end)

entity:SetCallback("OnDamagePlayer", function(newHealth)
	task.spawn(function()
		local model = entity.Model

		if not model then
			GiveAchievement()
			return
		end

		WaitForDespawn(model)
	end)
end)

entity:SetCallback("OnDespawning", function()
	print("Smiletly despawning")
end)

entity:SetCallback("OnDespawned", function()
	task.wait(0.1)
	GiveAchievement()
end)

entity:Run()
