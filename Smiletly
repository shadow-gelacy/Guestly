local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Spawner = loadstring(game:HttpGet(
	"https://raw.githubusercontent.com/RegularVynixu/DOORS-Entity-Spawner-V2/main/init.luau"
))()

local achievementGiver = loadstring(
	game:HttpGet(
		"https://raw.githubusercontent.com/RegularVynixu/Utilities/main/Doors/Custom%20Achievements/Source.lua"
	)
)()

local IMAGE_ID = "rbxassetid://99861030954861"
local achievementGiven = false

local function Create2DEntity(model)
	if not model then
		return
	end

	local root =
		model:FindFirstChild("HumanoidRootPart")
		or model.PrimaryPart
		or model:FindFirstChildWhichIsA("BasePart")

	if not root then
		warn("Smiletly: no BasePart found")
		return
	end

	-- Hide the original model
	for _, v in ipairs(model:GetDescendants()) do
		if v:IsA("BasePart") then
			v.Transparency = 1
			v.CanCollide = false
			v.CanTouch = false
			v.CanQuery = false
		elseif v:IsA("Decal") or v:IsA("Texture") then
			v.Transparency = 1
		end
	end

	-- 2D image
	local gui = Instance.new("SurfaceGui")
	gui.Name = "Smiletly2D"
	gui.Adornee = root
	gui.Face = Enum.NormalId.Front

	-- Wall occlusion
	gui.AlwaysOnTop = false
	gui.LightInfluence = 0
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 100
	gui.Parent = root

	local image = Instance.new("ImageLabel")
	image.Name = "SmiletlyImage"
	image.BackgroundTransparency = 1
	image.Size = UDim2.fromScale(1, 1)
	image.Image = IMAGE_ID
	image.ScaleType = Enum.ScaleType.Fit
	image.Parent = gui
end

local function GiveAchievement()
	if achievementGiven then
		return
	end

	achievementGiven = true

	pcall(function()
		achievementGiver({
			Title = "how why?",
			Desc = "Don't leave hiding spot",
			Reason = "Encounter smiletly.",
			Image = IMAGE_ID
		})
	end)
end

local function WaitForDespawn(model)
	if not model then
		GiveAchievement()
		return
	end

	local start = tick()

	while model.Parent and tick() - start < 10 do
		task.wait(0.05)
	end

	if not model.Parent then
		GiveAchievement()
	end
end

